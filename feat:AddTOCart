 import java.util.ArrayList;
import java.util.Scanner;
class Product {
    String name;
    double price;
    Product(String name, double price) {
        this.name = name;
        this.price = price;
    }
}
public class AddToCart {
    static void addToCart(
            Scanner sc,
            ArrayList<Product> products,
            ArrayList<Product> cart) {
        System.out.println("===== AVAILABLE PRODUCTS =====");
        for (int i = 0; i < products.size(); i++) {
            Product product = products.get(i);
            System.out.println(
                    (i + 1) + ". "
                    + product.name
                    + " - ₹"
                    + product.price);
        }
        System.out.print("\nEnter Product Number: ");
        int productNo = sc.nextInt();
        if (productNo >= 1 && productNo <= products.size()) {
            Product selectedProduct =
                    products.get(productNo - 1);
            cart.add(selectedProduct);
            System.out.println(
                    selectedProduct.name
                    + " Added to Cart Successfully!");
        } else {
            System.out.println("Invalid Product Number!");
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<Product> products = new ArrayList<>();
        products.add(new Product("Laptop", 45000));
        products.add(new Product("Headphone", 1500));
        products.add(new Product("Bag", 1200));
        products.add(new Product("Watch", 2500));
        products.add(new Product("Mobile", 15000));
        products.add(new Product("Keyboard", 800));
        products.add(new Product("Mouse", 500));
        products.add(new Product("Charger", 700));
        products.add(new Product("Power Bank", 1200));
        ArrayList<Product> cart = new ArrayList<>();
        addToCart(sc, products, cart);
        sc.close();
    }
}
